{
  "name": "klaudio-panels",
  "version": "1.10.0",
  "description": "Klaudio Panels — native window embedding the Claude Code CLI",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "validate": "bun run typecheck && bun test && cd src-tauri && cargo check && cargo clippy -- -D warnings",
    "dev:app": "tauri dev",
    "dev:app:fresh-bridge": "cargo build --manifest-path src-tauri/Cargo.toml --bin klaudio-statusline-bridge && tauri dev",
    "bridge:prepare": "bash src-tauri/scripts/prepare-statusline-bridge.sh",
    "bridge:prepare:macos-universal": "bash src-tauri/scripts/prepare-statusline-bridge-universal-macos.sh",
    "package:linux": "bun run bridge:prepare -- x86_64-unknown-linux-gnu && tauri build --config src-tauri/tauri.bundle.conf.json",
    "release:mac": "bun run bridge:prepare:macos-universal && tauri build --config src-tauri/tauri.bundle.conf.json --target universal-apple-darwin"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@lezer/highlight": "^1.2.3",
    "@pierre/diffs": "^1.1.16",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.12",
    "lucide-solid": "^1.8.0",
    "marked": "^18.0.6",
    "shiki": "^3.23.0",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.13",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0"
  }
}
